# ═══════════════════════════════════════════════
# ARYA & MENTAL COLLAB BOT — Environment Variables
# ═══════════════════════════════════════════════
#
# ⚠️  DO NOT commit .env (real values)
# ✅  This file (.env.example) is safe to commit
# 📋  Copy this to .env locally:
#       cp .env.example .env
#

# ─────────────────────────────────────────────
# Telegram Bot Credentials (REQUIRED)
# ─────────────────────────────────────────────
# Get from @BotFather on Telegram:
#   → /newbot → follow steps → copy token
TELEGRAM_BOT_TOKEN=

# Get from @userinfobot on Telegram:
#   → /start → copy the ID number
TELEGRAM_OWNER_ID=


# ─────────────────────────────────────────────
# Storage Directory
# ─────────────────────────────────────────────
# Free tier Render: use "." (ephemeral)
# Starter plan:     use "/var/data" (persistent disk)
DATA_DIR=.


# ─────────────────────────────────────────────
# Timezone (IST — for 7AM/7PM purge)
# ─────────────────────────────────────────────
TZ=Asia/Kolkata


# ─────────────────────────────────────────────
# Node.js Version (Render)
# ─────────────────────────────────────────────
NODE_VERSION=20


# ─────────────────────────────────────────────
# Port (Render sets automatically)
# Leave commented for local
# ─────────────────────────────────────────────
# PORT=3000
